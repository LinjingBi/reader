[project]
name = "paperchunk"
version = "0.0.3"
description = "Async paper fetching, heading-block parsing, selector matching, and selector->texts scoring/training artifacts."
requires-python = ">=3.10"
dependencies = [
  "pyyaml>=6.0",
  "httpx>=0.24",
  "selectolax>=0.3.0",
  "pymupdf>=1.22; platform_system != 'Emscripten'",
]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"
